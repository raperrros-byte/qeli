# Локальные секреты lab — скопируйте в `.lab_secrets` и заполните.
# Файл `.lab_secrets` в git не попадает.

# SSH (основной lab VPS)
SSH_HOST=<SERVER_IP>
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=<SSH_PASSWORD>

# SSH (второй lab VPS, опционально)
SSH_HOST2=<SERVER2_IP>
SSH_PORT2=22
SSH_USER2=root
SSH_PASSWORD2=<SSH_PASSWORD2>

# Веб-панель
PANEL_URL=https://panel.example.com
PANEL_USER=admin
PANEL_PASSWORD=<PANEL_PASSWORD>

PANEL_URL2=https://panel2.example.com
PANEL_USER2=admin
PANEL_PASSWORD2=<PANEL_PASSWORD2>

# Деплой nginx / clean-reinstall-lab.sh / remote-reinstall-host2.sh
PANEL_DOMAIN=panel.example.com
PANEL_ALLOW_CIDRS=<OFFICE_CIDR>,<VPN_POOL_CIDR>
# Пример: 203.0.113.0/24,10.9.0.0/16

# Путь к PEM на вашей машине (fullchain + private key в одном файле)
# TLS_CERT_PEM=/path/to/wildcard.example.com.pem
