# Nginx stream: SNI split on :443 — panel domain vs reality-tls backend.
# Copy to /etc/nginx/stream.d/qeli-sni.conf and replace placeholders.
#
# Requires: apt-get install -y nginx libnginx-mod-stream
# In /etc/nginx/nginx.conf (outside http {}):
#   stream { include /etc/nginx/stream.d/*.conf; }

geo $remote_addr $panel_allowed {
    __PANEL_ALLOW_CIDR_1__ 1;
    __PANEL_ALLOW_CIDR_2__ 1;
    default                 0;
}

map "$ssl_preread_server_name:$panel_allowed" $qeli_upstream {
    "__PANEL_DOMAIN__:1"  127.0.0.1:8080;
    "__PANEL_DOMAIN__:0"  127.0.0.1:9;
    default               127.0.0.1:4430;
}

server {
    listen 443 reuseport;
    listen [::]:443 reuseport;
    proxy_pass $qeli_upstream;
    ssl_preread on;
    proxy_connect_timeout 10s;
    proxy_timeout 24h;
}
