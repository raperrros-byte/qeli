# Template for release APK signing. Copy to `keystore.properties` (git-ignored).
#
# Local sideload (Windows): run `scripts/agent/build_android_apk.ps1` — it
# creates `qeli-dev-release.jks` + keystore.properties automatically on first
# run. Keep the same .jks for in-place updates; bump versionCode each release.
#
# Without keystore.properties, release builds use the debug key (fallback in
# build.gradle.kts) — only updates over debug from the same machine.
#
# 1) Generate a release keystore once (keep it + these passwords safe — losing
#    them means you can never update the app under the same identity):
#
#    keytool -genkeypair -v \
#      -keystore qeli-release.jks \
#      -alias qeli \
#      -keyalg RSA -keysize 4096 -validity 10000
#
# 2) Copy this file to keystore.properties and set the four values below.
# 3) Build: ./gradlew assembleRelease  (now signed)

storeFile=qeli-release.jks
storePassword=CHANGE_ME
keyAlias=qeli
keyPassword=CHANGE_ME
